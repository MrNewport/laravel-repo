{
    "name": "mrnewport/laravel-repo",
    "description": "A Laravel package that fetches your GitHub repositories and saves README files into db for use on web pages",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Newport",
            "email": "admin@matthewnewport.com",
            "homepage": "https://github.com/MrNewport",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "MrNewport\\LaravelRepo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MrNewport\\LaravelRepo\\Providers\\RepoServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "pest"
    },
    "autoload-dev": {
        "psr-4": {
            "MrNewport\\LaravelRepo\\Tests\\": "tests/"
        }
    }
}
